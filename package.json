    "import": "tsx --env-file=.env.local scripts/import-workbook.mts",
    "verify:four-week": "tsx --env-file=.env.local scripts/verify-four-week-rule.mts",
    "verify:scope": "tsx --env-file=.env.local scripts/verify-access-scope.mts",
