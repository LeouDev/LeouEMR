# ---------------------------------------------------------------------------
# Database
#
# Use a Supabase POOLER connection string, never the direct db.*.supabase.co
# host — that host is IPv6-only for new projects and unreachable from most
# networks and hosting providers.
#
#   Local development : session pooler, port 5432
#   Production        : transaction pooler, port 6543
#
# Transaction mode is what serverless needs, because each instance opens its
# own connection and session mode holds them until the instance dies.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# In production the app should connect as the limited role instead —
# scripts/sql/app-role.sql creates it — with the same host and port and only
# the username's first segment and the password changed:
#   postgresql://emr_app.<project-ref>:<app-role-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Keep the postgres role here locally: migrations and scripts/backup-db.sh
# need it.

# ---------------------------------------------------------------------------
# Supabase Auth (Project Settings > API)
#
# The publishable/anon key is safe in the browser: it relies on Postgres
# Row-Level Security, which this project enables on every table with no
# permissive policies except "read your own users row".
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required, and server-only: it bypasses RLS entirely, so never prefix it
# with NEXT_PUBLIC_. Application data goes through Drizzle over DATABASE_URL,
# but the Import page needs this key to sign the direct-to-Storage upload URL
# and to read the workbook back (src/app/(shell)/import/actions.ts), and the
# Users page needs it for the Auth admin API. Unset, every import fails at
# the upload step.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# End-of-day report email (src/app/(shell)/my-stats/actions.ts)
#
# A separate mailbox from Supabase Auth's own SMTP settings — GoTrue's SMTP
# config only ever sends GoTrue's own auth emails, there is no way for
# application code to reuse it. For Gmail, EOD_SMTP_USER needs a 16-character
# App Password (myaccount.google.com/apppasswords, requires 2-Step
# Verification) rather than the normal account password, which Gmail
# rejects for SMTP. EOD_SMTP_FROM defaults to EOD_SMTP_USER when unset — most
# providers, Gmail included, reject or spam-flag a From address that is not
# the authenticated mailbox, so this is only for a verified alias on that
# same account, never an arbitrary address. Port 465 is TLS from the first
# byte; any other port must offer STARTTLS (587 does on Gmail and Brevo) or
# the send is refused rather than sent with the password in the clear.
# ---------------------------------------------------------------------------
EOD_SMTP_HOST=smtp.gmail.com
EOD_SMTP_PORT=465
EOD_SMTP_USER=
EOD_SMTP_PASS=
EOD_SMTP_FROM=

# ---------------------------------------------------------------------------
# Who may sign up, and who reports may be sent to
#
# Comma-separated email domains. SIGNUP_EMAIL_DOMAINS limits new accounts to
# company addresses (unset = anyone, pending an administrator's approval).
# MAIL_ALLOWED_DOMAINS limits the end-of-day report's recipient to company
# addresses; the sender's own team leader and manager are always allowed,
# and with it unset the sender's own email domain stands in. Public mail
# providers (gmail.com and the like) never count as a company domain either
# way. Each account may send at most 10 reports a day, counted off the
# audit log.
# ---------------------------------------------------------------------------
SIGNUP_EMAIL_DOMAINS=
MAIL_ALLOWED_DOMAINS=

# ---------------------------------------------------------------------------
# Second step at sign-in (authenticator app)
#
# Admin, manager and supervisor accounts must pair an authenticator app and
# enter its code at sign-in (src/lib/auth/mfa.ts). Unset, that is enforced
# at their next sign-in. A date (YYYY-MM-DD) delays enforcement to that day:
# until then they see a reminder banner instead. Requires TOTP to be enabled
# under Authentication > Multi-Factor in Supabase.
# ---------------------------------------------------------------------------
MFA_GRACE_UNTIL=
