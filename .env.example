# ---------------------------------------------------------------------------
# Database
#
# Use a Supabase POOLER connection string, never the direct db.*.supabase.co
# host — that host is IPv6-only for new projects and unreachable from most
# networks and hosting providers.
#
#   Local development : session pooler, port 5432
#   Production        : transaction pooler, port 6543
#
# Transaction mode is what serverless needs, because each instance opens its
# own connection and session mode holds them until the instance dies.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Supabase Auth (Project Settings > API)
#
# The publishable/anon key is safe in the browser: it relies on Postgres
# Row-Level Security, which this project enables on every table with no
# permissive policies except "read your own users row".
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_.
# Not currently required: data access goes through Drizzle over DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# End-of-day report email (src/app/(shell)/my-stats/actions.ts)
#
# A separate mailbox from Supabase Auth's own SMTP settings — GoTrue's SMTP
# config only ever sends GoTrue's own auth emails, there is no way for
# application code to reuse it. For Gmail, EOD_SMTP_USER needs a 16-character
# App Password (myaccount.google.com/apppasswords, requires 2-Step
# Verification) rather than the normal account password, which Gmail
# rejects for SMTP. EOD_SMTP_FROM defaults to EOD_SMTP_USER when unset — most
# providers, Gmail included, reject or spam-flag a From address that is not
# the authenticated mailbox, so this is only for a verified alias on that
# same account, never an arbitrary address.
# ---------------------------------------------------------------------------
EOD_SMTP_HOST=smtp.gmail.com
EOD_SMTP_PORT=465
EOD_SMTP_USER=
EOD_SMTP_PASS=
EOD_SMTP_FROM=
