# Postgres connection string for Drizzle (drizzle-kit generate/migrate/studio
# and the app's db client). Use the Supabase project's "Connection string"
# (Session pooler or direct connection) from Project Settings > Database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Supabase project (Project Settings > API). The anon key is safe to expose
# client-side — it relies on Postgres Row-Level Security, which must be
# configured on every table before this goes anywhere near production data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
